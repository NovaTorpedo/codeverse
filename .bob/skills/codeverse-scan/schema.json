{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "codeverse.semantic"
    },
    "synthetic": {
      "default": false,
      "type": "boolean"
    },
    "generatedBy": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string",
          "enum": [
            "ibm-bob",
            "codeverse-synthetic"
          ]
        },
        "client": {
          "type": "string",
          "enum": [
            "bob-ide",
            "bob-shell",
            "fixture"
          ]
        },
        "mode": {
          "type": "string",
          "maxLength": 80
        },
        "skill": {
          "type": "string",
          "maxLength": 80
        },
        "recordedAt": {
          "type": "string",
          "maxLength": 40
        }
      },
      "required": [
        "tool"
      ]
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "summary": {
      "type": "string",
      "maxLength": 8000
    },
    "services": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 200
          },
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "responsibility": {
            "type": "string",
            "maxLength": 8000
          },
          "citations": {
            "minItems": 1,
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "line": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "endLine": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "symbol": {
                  "type": "string",
                  "maxLength": 200
                }
              },
              "required": [
                "file"
              ]
            }
          }
        },
        "required": [
          "id",
          "name",
          "responsibility",
          "citations"
        ]
      }
    },
    "entryPoints": {
      "default": [],
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "symbol": {
            "type": "string",
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 400
          },
          "citations": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "line": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "endLine": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "symbol": {
                  "type": "string",
                  "maxLength": 200
                }
              },
              "required": [
                "file"
              ]
            }
          }
        },
        "required": [
          "file",
          "description",
          "citations"
        ]
      }
    },
    "dataFlows": {
      "default": [],
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80
          },
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 8000
          },
          "steps": {
            "minItems": 1,
            "maxItems": 40,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string",
                  "maxLength": 600
                },
                "to": {
                  "type": "string",
                  "maxLength": 600
                },
                "via": {
                  "type": "string",
                  "maxLength": 200
                },
                "citation": {
                  "type": "object",
                  "properties": {
                    "file": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    "line": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "endLine": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "symbol": {
                      "type": "string",
                      "maxLength": 200
                    }
                  },
                  "required": [
                    "file"
                  ]
                }
              },
              "required": [
                "from",
                "to",
                "citation"
              ]
            }
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "steps"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "generatedBy",
    "target",
    "summary",
    "services"
  ]
}
